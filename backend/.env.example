# Copy to backend/.env for local development. Never commit real secrets.
APP_ENV=development
DATABASE_URL=sqlite:///./savj.db
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private proof image storage; keep outside the frontend's public directory
SAVJ_UPLOAD_DIR=./private_uploads
