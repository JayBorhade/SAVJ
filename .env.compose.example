# Local Docker Compose example only. Do not use these settings as production defaults.
# Copy to .env and replace both values with unique random hex strings.
# Do not commit .env.
POSTGRES_PASSWORD=replace_with_random_hex
JWT_SECRET=replace_with_at_least_32_random_characters
APP_ENV=development
CORS_ORIGINS=http://localhost:8080

# Required when APP_ENV=production; configure a real SMTP provider and your public HTTPS URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
PUBLIC_APP_URL=https://savj.example.com
